# Copy to .env and fill in. Never commit real secrets.

# --- Core ---
ENVIRONMENT=development                 # development | test | production
DATABASE_URL=postgresql+asyncpg://mindguard:mindguard@localhost:5432/mindguard
REDIS_URL=redis://localhost:6379/0      # optional; without it rate limits and the LLM cache are per-process
JWT_SECRET=                             # REQUIRED: at least 32 random characters in production
ADMIN_EMAILS=                           # comma-separated; these accounts get the admin role at registration
CORS_ORIGINS=http://localhost:3000

# --- Models (all optional: the default configuration runs fully offline) ---
LLM_PROVIDER=mock                       # mock | anthropic | openai_compatible | disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_REASONING_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_USER_DAILY_TOKEN_BUDGET=40000
LLM_MONTHLY_BUDGET_USD=25
MODEL_PRICING_JSON={}                   # {"model":{"input_per_mtok":3.0,"output_per_mtok":15.0}} for cost accounting

VISION_PROVIDER=disabled                # disabled | anthropic
VISION_API_KEY=

EMBEDDING_PROVIDER=hashing              # hashing (offline, 384-d) | openai_compatible
EMBEDDING_API_KEY=

# --- Observability ---
OTEL_ENDPOINT=                          # e.g. http://localhost:4318 for OTLP/HTTP traces
METRICS_TOKEN=                          # if set, /metrics requires this bearer token

# --- Docker compose only ---
POSTGRES_USER=mindguard
POSTGRES_PASSWORD=mindguard
POSTGRES_DB=mindguard
BACKEND_PORT=8000
WEB_PORT=3000

# --- Web dashboard (server-side only) ---
MINDGUARD_API_URL=http://localhost:8000
