<?xml version="1.0" encoding="utf-8"?>
<!-- Every permission is documented in docs/android.md. Special-access permissions are granted by the user in system settings. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talk to the MindGuard API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- JobScheduler network constraint for event sync. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Special access (Settings > Usage access): which app is in the foreground and for how long. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Runtime permission on Android 13+: interventions and the persistent protection notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Special access (Display over other apps): pause screens and delay gates. Optional. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Special access (Do Not Disturb): silence notifications during focus sessions. Optional. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Visible foreground service while the guardian is on (Android 14 requires a declared type). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Resume protection after reboot, only if the user had enabled it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility limited to the apps MindGuard can monitor (no QUERY_ALL_PACKAGES). -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.twitter.android" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.reddit.frontpage" />
    </queries>

    <application
        android:name="dev.mindguard.app.MindGuardApplication"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity android:name="dev.mindguard.app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="dev.mindguard.app.ShareActivity" android:exported="true" android:label="@string/share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
            </intent-filter>
        </activity>

        <service android:name="dev.mindguard.monitoring.GuardianService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Digital wellbeing: user-enabled monitoring of chosen apps' foreground time to show self-configured reminders" />
        </service>

        <service android:name="dev.mindguard.monitoring.SyncJobService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name="dev.mindguard.monitoring.BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>

        <receiver android:name="dev.mindguard.intervention.InterventionActionReceiver" android:exported="false" />
    </application>
</manifest>
